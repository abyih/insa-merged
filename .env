# REACT_APP_OPENSTACK_IP=10.0.2.15
# REACT_APP_OPENSTACK_AUTH_URL=http://10.0.2.15/identity/v3
# REACT_APP_USERNAME=admin
# REACT_APP_PASSWORD=secret
