# REACT_APP_PROJECT_DOMAIN_NAME=Default








VITE_OPENSTACK_IP=10.0.2.15
VITE_OPENSTACK_AUTH_URL=http://10.0.2.15/identity/v3
VITE_OS_USERNAME=admin
VITE_OS_PASSWORD=secret
VITE_OS_PROJECT_NAME=admin
VITE_OS_DOMAIN_NAME=Default
PORT=5050

# ONOS controller (docker container "onos-concurrent", ports remapped to avoid
# colliding with ODL's own 6653/8181/8101 on this host).
# NOT VITE_-prefixed on purpose: VITE_ vars get bundled into the browser's JS,
# which would ship these credentials client-side and also only work if the
# browser itself can reach ONOS_PORT directly (it often can't, e.g. behind a
# dev-environment port forwarder). server.js proxies this instead, same as ODL.
ONOS_HOST=localhost
ONOS_PORT=8183
ONOS_USERNAME=onos
ONOS_PASSWORD=rocks

# ODL northbound RESTCONF over TLS. The self-signed cert is trusted via
# NODE_EXTRA_CA_CERTS=./odl-tls-cert.pem, set in the "server" npm script
# (must be set at process start — Node's TLS trust store isn't editable
# at runtime, so this can't just be picked up here by dotenv).
ODL_URL=https://127.0.0.1:8443/rests/data

# AI Intent Engine (Gemini). NOT VITE_-prefixed — same reason as ONOS above,
# this key must stay server-side. server.js's /api/intent/compile route is
# the only thing that reads it. Leave blank to run on the offline heuristic
# parser only (src/utils/intentParser.js) — the app falls back to it
# automatically, nothing breaks if this is empty.
GEMINI_API_KEY=AIzaSyAJlJWKRtHG5aXIABz2TKkfeXuPdsUZroc
GEMINI_MODEL=gemini-3.5-flash